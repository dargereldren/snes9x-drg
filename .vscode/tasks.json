{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake configure",
			"type": "shell",
			"command": "cmake . -B build",
			"group": "build"
		},
		{
			"label": "make build",
			"type": "shell",
			"command": "cmake --build build --config Release --parallel $(nproc)",
			"dependsOn": [
				"cmake configure"
			],
			"group": "build"
		}
	]
}